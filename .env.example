# COGEXT environment configuration.
# Copy to .env and fill in real values:  cp .env.example .env
#
# NOTE: every key here must also be declared as a field on `Settings` in
# config.py. pydantic-settings rejects unknown keys found in the .env file,
# so adding an undeclared variable here will crash startup.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase pooler URL (port 6543, NOT 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NOT the anon key

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek                      # "deepseek" (Groq remains a dead fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                        # set to "production" on Render

# ── Kill Switch (Slack alerts) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
# HMAC secret used to sign one-click approve/cancel action tokens and public
# audit receipt tokens. Required: at least 32 random characters. Without it,
# receipt signing returns 503 and receipts never verify.
ACTION_TOKEN_SECRET=

# Private key for verifying observer-signed live receipts (signers set the same
# value as COGEXT_RECEIPT_KEY). At least 32 random characters; no default.
# Unset means every live receipt reports "unverifiable". Give it only to
# first-party signers: anyone holding it can sign receipts that verify.
OBSERVE_RECEIPT_KEY=
# When OBSERVE_RECEIPT_KEY went live, e.g. 2026-10-20T12:00:00+00:00 (timezone
# required, never in the future). Receipts stored earlier and signed with the
# old public observer key report "legacy" instead of "unsigned". Not secret.
LIVE_RECEIPT_LEGACY_CUTOFF=

# ── Email / notifications ────────────────────────────────────────────────────
# Resend is the preferred transport: it goes over HTTPS, whereas Render's free
# tier blocks outbound traffic to SMTP ports 25/465/587.
RESEND_API_KEY=
# Signup alerts are sent here.
NOTIFY_EMAIL=hello@cogextai.com
# Sender address. Must be on a domain verified in Resend.
NOTIFY_FROM=hello@cogextai.com

# SMTP fallback, used only when RESEND_API_KEY is empty (e.g. local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── Billing ──────────────────────────────────────────────────────────────────
PAYPAL_WEBHOOK_ID=
# PayPal REST app credentials. Required to verify webhook signatures; without
# them every PayPal webhook is rejected with 503.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
