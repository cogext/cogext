# COGEXT environment configuration.
# Copy to .env and fill in real values:  cp .env.example .env
#
# NOTE: every key here must also be declared as a field on `Settings` in
# config.py. pydantic-settings rejects unknown keys found in the .env file,
# so adding an undeclared variable here will crash startup.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase pooler URL (port 6543, NOT 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NOT the anon key

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek                      # "deepseek" (Groq remains a dead fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                        # set to "production" on Render

# ── Kill Switch (Slack alerts) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
# HMAC secret used to sign one-click approve/cancel action tokens.
# Change this in production.
ACTION_TOKEN_SECRET=

# ── Email / notifications ────────────────────────────────────────────────────
# Resend is the preferred transport: it goes over HTTPS, whereas Render's free
# tier blocks outbound traffic to SMTP ports 25/465/587.
RESEND_API_KEY=
# Signup alerts are sent here.
NOTIFY_EMAIL=hello@cogextai.com
# Sender address. Must be on a domain verified in Resend.
NOTIFY_FROM=hello@cogextai.com

# SMTP fallback, used only when RESEND_API_KEY is empty (e.g. local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── Billing ──────────────────────────────────────────────────────────────────
PAYPAL_WEBHOOK_ID=
